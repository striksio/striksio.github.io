---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectTile from '../components/ProjectTile.astro';
import { site } from '../site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured);
const others = projects.filter((p) => !p.data.featured);
---

<Base>
  <section class:list={['hero', 'wrap', { 'with-photo': site.hero.image }]}>
    <div>
    <p class="hero-kicker mono">{site.tagline}</p>
    <h1 class="mono" aria-label={site.name}>
      {site.displayName.split('.')[0]}<span class="ext">.{site.displayName.split('.').slice(1).join('.')}</span><span class="cursor" aria-hidden="true"></span>
    </h1>
    <p class="hero-intro">{site.intro}</p>
    <div class="btn-row">
      <a class="btn primary" href="#projects">See projects</a>
      {site.links.map((l) => <a class="btn" href={l.url}>{l.label}</a>)}
      {site.email && <a class="btn" href={`mailto:${site.email}`}>Email</a>}
    </div>
    </div>
    {
      site.hero.image && (
        <div class="hero-photo">
          <div class="bbox cutout">
            <span class="bbox-label">{site.hero.label}</span>
            <img src={site.hero.image} alt={site.hero.alt} width="1100" height="700" />
          </div>
        </div>
      )
    }
  </section>

  <section class="section wrap" id="projects">
    <h2 class="section-label">Projects</h2>
    {featured.map((p, i) => <ProjectCard project={p} index={i} />)}
  </section>

  {
    site.publications.length > 0 && (
      <section class="section wrap" id="publications">
        <h2 class="section-label">Publications</h2>
        <ul class="pubs">
          {site.publications.map((pub) => (
            <li>
              <span class="mono pub-year">{pub.year}</span>
              <div>
                <a class="pub-title" href={pub.url}>{pub.title}</a>
                <p>{pub.authors}</p>
                <p>
                  <em>{pub.venue}</em>
                  {pub.project && (
                    <>
                      {' · '}
                      <a href={`/projects/${pub.project}/`}>project page</a>
                    </>
                  )}
                </p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    others.length > 0 && (
      <section class="section wrap" id="fundamentals">
        <h2 class="section-label">Fundamentals and experiments</h2>
        <div class="tiles">
          {others.map((p) => <ProjectTile project={p} />)}
        </div>
      </section>
    )
  }

  <section class="section wrap" id="contact">
    <h2 class="section-label">Contact</h2>
    <p class="contact-text">Want to talk about computer vision or edge AI? Find me here:</p>
    <div class="btn-row">
      {site.email && <a class="btn primary" href={`mailto:${site.email}`}>{site.email}</a>}
      {site.links.map((l) => <a class="btn" href={l.url}>{l.label}</a>)}
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: 6.5rem 0 2rem;
  }
  .hero.with-photo {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: 3rem;
    align-items: center;
  }
  .hero-photo {
    margin-top: 1.2rem;
    position: relative;
  }
  /* Warm glow behind the cut-out board. */
  .hero-photo::before {
    content: '';
    position: absolute;
    inset: -12%;
    background: radial-gradient(closest-side, rgba(255, 100, 51, 0.22), transparent);
    filter: blur(20px);
    pointer-events: none;
  }
  .cutout {
    background: transparent;
    border-color: rgba(255, 100, 51, 0.35);
    padding: 1.5rem;
  }
  .cutout img {
    filter: drop-shadow(0 18px 22px rgba(0, 0, 0, 0.7));
  }
  .hero-kicker {
    color: var(--accent);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 1.25rem;
  }
  h1 {
    font-size: clamp(2.6rem, 7vw, 4.6rem);
    font-weight: 700;
    letter-spacing: -0.04em;
  }
  h1 .ext {
    color: var(--muted);
  }
  h1 .cursor {
    display: inline-block;
    width: 0.55em;
    height: 0.09em;
    margin-left: 0.08em;
    background: var(--accent);
    vertical-align: baseline;
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    h1 .cursor {
      animation: none;
    }
  }
  .hero-intro {
    max-width: 620px;
    font-size: 1.2rem;
    color: var(--soft);
    margin: 1.5rem 0 2rem;
  }
  .pubs {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .pubs li {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 1rem;
  }
  .pub-year {
    color: var(--muted);
    font-size: 0.85rem;
    padding-top: 0.2rem;
  }
  .pub-title {
    color: var(--text);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .pub-title:hover {
    color: var(--accent);
  }
  .pubs p {
    margin: 0.3rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr));
    gap: 1rem;
  }
  .contact-text {
    margin: 0 0 1.25rem;
    color: var(--soft);
  }
  @media (max-width: 860px) {
    .hero.with-photo {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }
  }
  @media (max-width: 640px) {
    .hero {
      padding-top: 4rem;
    }
    .pubs li {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>

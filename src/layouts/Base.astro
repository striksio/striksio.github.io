---
import '../styles/global.css';
import { site } from '../site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description = site.intro, image } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} (${site.displayName}) · ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: [site.displayName, site.handle],
  url: Astro.site,
  description: site.intro,
  sameAs: site.links.map((l) => l.url),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="author" content={site.name} />
    {site.googleSiteVerification && <meta name="google-site-verification" content={site.googleSiteVerification} />}
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <meta name="theme-color" content="#0d0d0f" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/" aria-label={`${site.name}, home`}>
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <path d="M4 11V4h7M21 4h7v7M28 21v7h-7M11 28H4v-7" fill="none" stroke="#ff7a1a" stroke-width="2.5"></path>
            <circle cx="16" cy="16" r="3.5" fill="#ff7a1a"></circle>
          </svg>
          {site.handle}
        </a>
        <nav class="site-nav" aria-label="Main">
          <a href="/#projects">projects</a>
          <a href="/#publications">publications</a>
          <a href="/#contact">contact</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <span>
          {site.links.map((l) => <a href={l.url}>{l.label}</a>)}
        </span>
      </div>
    </footer>
  </body>
</html>
